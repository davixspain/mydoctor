# MyDoctor — config locale (copialo in `.env` accanto a questo file e compila)
# Permessi consigliati: chmod 600 .env
# Il file .env contiene segreti: NON va condiviso, NON va committato.

# ─── Telegram (obbligatori) ───────────────────────────────────────────────────

# Token del bot Telegram dedicato (creato con @BotFather → /newbot)
MYDOCTOR_BOT_TOKEN=

# Il TUO chat_id Telegram (l'unico che il bot accetterà come proprietario).
# Per scoprirlo: lascia vuoto, avvia il bot, scrivi /start dal tuo Telegram,
# il bot ti risponderà col tuo chat_id. Mettilo qui e riavvia.
MYDOCTOR_OWNER_CHAT_ID=

# ─── Paths (opzionali — il wizard li imposta automaticamente) ─────────────────

# Root del prodotto installato (vault, log, sessioni, .env). Se vuoto, viene
# usato $HOME/MyDoctor su Linux/macOS, %USERPROFILE%\MyDoctor su Windows.
MYDOCTOR_HOME=

# Path completo del binario Claude Code. Se vuoto, viene cercato nel PATH.
# Linux/macOS:  ~/.local/bin/claude  oppure  /usr/local/bin/claude
# Windows:      %USERPROFILE%\.local\bin\claude.exe
CLAUDE_BIN=

# ─── Timeout e tuning (opzionali, defaults sicuri) ────────────────────────────

# Timeout massimo per chiamata a Claude in chat interattiva (secondi). 480 = 8 min.
MYDOCTOR_TIMEOUT=480

# Timeout per le review schedulate (più lungo perché devono leggere il vault).
MYDOCTOR_REVIEW_TIMEOUT=900

# Se vuoi disabilitare il push proattivo su Telegram (review settimanale/mensile)
# senza disinstallare i timer: imposta a 1
MYDOCTOR_DISABLE_PROACTIVE_PUSH=0
